# Our own warehouse database (dim_product / fact_sales / mart_daily_sales) —
# separate from Airflow's own metadata database, which is configured
# directly in docker-compose.yml / airflow.cfg, not here.
WAREHOUSE_DATABASE_URL=postgresql+psycopg2://warehouse:warehouse@localhost:5432/warehouse

# Base URL of the FastAPI supplier stub (api_stub/), used by SupplierApiHook.
API_STUB_BASE_URL=http://localhost:8099

LOG_LEVEL=INFO
